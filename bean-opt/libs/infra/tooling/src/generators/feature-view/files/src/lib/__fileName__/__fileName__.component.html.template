<div class="h-full flex flex-col p-6 space-y-8 animate-in fade-in slide-in-from-bottom-4 duration-500">
  
  <!-- Header -->
  <header>
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-2xl md:text-3xl font-black uppercase tracking-tighter text-slate-900 italic">
          <%= className %>
        </h1>
        <p class="text-[10px] font-bold uppercase tracking-[0.3em] text-indigo-500 mt-1">
          WFi / <%= domainClassName %> System
        </p>
      </div>
      
      <!-- Action Placeholder -->
      <div class="h-10 w-10 rounded-full bg-slate-900 text-white flex items-center justify-center shadow-lg active:scale-90 transition-all cursor-pointer">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
        </svg>
      </div>
    </div>
  </header>

  <!-- Content Section -->
  <main class="flex-1">
    @if (store.loading()) {
      <div class="h-64 flex items-center justify-center">
        <div class="w-8 h-8 border-4 border-indigo-600 border-t-transparent rounded-full animate-spin"></div>
      </div>
    } @else {
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- View Content Here -->
        @for (item of store.items(); track item.id) {
           <div class="p-6 bg-white rounded-[2.5rem] border border-slate-100 shadow-sm">
             <span class="text-[9px] font-black uppercase tracking-widest text-slate-400">ID: {{item.id}}</span>
           </div>
        }
      </div>
    }
  </main>

</div>
