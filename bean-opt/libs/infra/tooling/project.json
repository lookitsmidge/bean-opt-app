{
  "name": "infra-tooling",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/infra/tooling/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/infra/tooling",
        "main": "libs/infra/tooling/src/index.ts",
        "tsConfig": "libs/infra/tooling/tsconfig.lib.json",
        "assets": [
          "libs/infra/tooling/*.md",
          {
            "input": "./libs/infra/tooling/src",
            "glob": "**/!(*.ts)",
            "output": "./src"
          },
          {
            "input": "./libs/infra/tooling/src",
            "glob": "**/*.d.ts",
            "output": "./src"
          },
          {
            "input": "./libs/infra/tooling",
            "glob": "generators.json",
            "output": "."
          },
          {
            "input": "./libs/infra/tooling",
            "glob": "executors.json",
            "output": "."
          }
        ]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/infra/tooling/jest.config.cts"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["libs/infra/tooling/**/*.ts", "libs/infra/tooling/package.json"]
      }
    }
  }
}
