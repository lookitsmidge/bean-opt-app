import { inject, Injectable } from "@angular/core";
import { Observable, from, map } from "rxjs";
import { <%= className %>, I<%= className %>Repository } from "@wfi/<%= fileName %>/domain";
import { FirebaseService } from "@wfi/shared/util";
import { 
    collection, 
    collectionData, 
    deleteDoc, 
    doc, 
    Firestore, 
    setDoc 
} from "@firebase/firestore";

@Injectable({ providedIn: 'root' })
export class Firebase<%= className %>Repository implements I<%= className %>Repository {
    private firebase = inject(FirebaseService);
    private readonly collectionName = '<%= fileName %>s';

    private get firestore(): Firestore {
        this.firebase.Init();
        return this.firebase.firestore;
    }

    get<%= className %>s(): Observable<<%= className %>[]> {
        const ref = collection(this.firestore, this.collectionName);
        return collectionData(ref, { idField: 'id' }) as Observable<<%= className %>[]>;
    }

    get<%= className %>ById(id: string): Observable<<%= className %> | null> {
        // Implementation for single fetch
        return this.get<%= className %>s().pipe(
            map(items => items.find(item => item.id === id) || null)
        );
    }

    async save<%= className %>(item: <%= className %>): Promise<void> {
        const ref = doc(this.firestore, this.collectionName, item.id);
        await setDoc(ref, item);
    }

    async delete<%= className %>(id: string): Promise<void> {
        const ref = doc(this.firestore, this.collectionName, id);
        await deleteDoc(ref);
    }
}
