{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2022",
    "module": "esnext",
    "lib": ["es2022", "dom"],
    "types": ["jest", "node"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "paths": {
      "@boa/core-ui": ["./libs/core/ui/src/index.ts"],
      "@boa/infra-util": ["./libs/infra/util/src/index.ts"],
      "@boa/infra-supabase": ["./libs/infra/supabase/src/index.ts"],
      "@boa/features-dashboard": ["./libs/features/dashboard/src/index.ts"],
      "@boa/core-auth-domain": ["./libs/core/auth/domain/src/index.ts"],
      "@boa/core-auth-domain/testing": [
        "./libs/core/auth/domain/src/testing/index.ts"
      ],
      "@boa/core-auth-application": [
        "./libs/core/auth/application/src/index.ts"
      ],
      "@boa/core-auth-data-access": [
        "./libs/core/auth/data-access/src/index.ts"
      ],
      "@boa/core-auth-feature": ["./libs/core/auth/feature/src/index.ts"],
      "@boa/core-auth-ui": ["./libs/core/auth/ui/src/index.ts"],
      "@boa/features/readings/domain": [
        "./libs/features/readings/domain/src/index.ts"
      ],
      "@boa/features/readings/application": [
        "./libs/features/readings/application/src/index.ts"
      ],
      "@boa/features/readings/data-access": [
        "./libs/features/readings/data-access/src/index.ts"
      ],
      "@boa/features/readings/feature": [
        "./libs/features/readings/feature/src/index.ts"
      ],
      "@boa/features/readings/ui": ["./libs/features/readings/ui/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
